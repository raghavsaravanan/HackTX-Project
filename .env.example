# Copy to .env. One file configures both apps. Blank keys fall back to mock mode.

# ---------- Sidequest game (Node: server/, web/) ----------

# Meta Model API (Muse Spark + Muse Voice Transcribe) — https://dev.meta.ai
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=low
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Google Gemini — https://aistudio.google.com
# Powers two agents: the Quest Agent (plans, guides, answers, updates missions and the map)
# and the Vision Agent (reads camera frames, answers checks with PASS / FAIL / UNCERTAIN).
GEMINI_API_KEY=
# Optional per-agent keys (separate quotas); blank uses GEMINI_API_KEY.
GEMINI_QUEST_API_KEY=
GEMINI_VISION_API_KEY=
GEMINI_MODEL=gemini-4-argon
# Optional per-agent overrides; blank uses GEMINI_MODEL.
GEMINI_QUEST_MODEL=
GEMINI_VISION_MODEL=
# MINIMAL | LOW | MEDIUM | HIGH. Lower is faster; Argon supports LOW and up.
GEMINI_THINKING_LEVEL=LOW

# "gemini" (default) or "muse". Either agent falls back to Muse Spark when Gemini is missing or fails.
VISION_PROVIDER=gemini
QUEST_AGENT_PROVIDER=gemini
# 1 (default): the Vision Agent must PASS a step before XP is awarded. 0 trusts the frame loop alone.
VERIFY_STEPS=1

# The agent's name. The phone listens for "Hi <name>"; narration uses this voice persona.
AGENT_NAME=Echo

# ElevenLabs (optional): narrator voice and speech to text. Without a key, narration uses on-device speech and Muse transcribes.
ELEVENLABS_API_KEY=
# Premade voice id from the ElevenLabs voice library.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Low-latency model for live narration.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Speech to text for the phone's microphone (falls back to Muse Voice Transcribe).
ELEVENLABS_STT_MODEL=scribe_v2
# After the wake phrase or a reply, follow-ups within this many ms need no wake phrase.
AWAKE_MS=20000

API_PORT=8787
# The API binds to 127.0.0.1 in dev (Vite proxies /api), so other devices can't spend your API quota.
# API_HOST=0.0.0.0

# Where the game reads the phone camera link's frames (the Python app's HTTP_PORT below). Blank disables it.
CAMERA_LINK_URL=http://127.0.0.1:8000
# How often (ms) the Vision Agent re-surveys the live camera to update the map's landmarks. 0 disables it.
SURVEY_INTERVAL_MS=60000

# ---------- Phone camera link (Python: app/, static/) ----------

HOST=0.0.0.0
# HTTPS port the phone opens
PORT=8443
# Plain HTTP on 127.0.0.1 for the laptop (the hub proxies it)
HTTP_PORT=8000

FRAME_MAX_SIDE=1120
FRAME_JPEG_QUALITY=85
FRAME_BUFFER_SIZE=30
# Set to a folder name (e.g. captures) to write every frame to disk
SAVE_FRAMES_DIR=

# The phone page's microphone audio and spoken narration go to the Sidequest game API through this server.
SIDEQUEST_API_URL=http://127.0.0.1:8787
# Game session the phone joins (the hub defaults to "demo"); override per phone with ?session=.
SIDEQUEST_SESSION=demo
