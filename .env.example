# Copy to .env. One file configures both apps. Blank keys fall back to mock mode.

# ---------- Sidequest game (Node: server/, web/) ----------

# Meta Model API (Muse Spark + Muse Voice Transcribe) — https://dev.meta.ai
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=low
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Google Gemini — https://aistudio.google.com
# Quest Agent (plan, guide, answer) and Vision Agent (camera frames, PASS/FAIL checks).
GEMINI_API_KEY=
GEMINI_QUEST_API_KEY=
GEMINI_VISION_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_QUEST_MODEL=gemini-3-flash-preview
GEMINI_VISION_MODEL=gemini-3-flash-preview
GEMINI_THINKING_LEVEL=LOW

# "muse" (default), "gemini", or "openai". Muse Spark runs both agents.
VISION_PROVIDER=muse
QUEST_AGENT_PROVIDER=muse
VERIFY_STEPS=1

# Wake phrase "Hi <name>"; narration persona.
AGENT_NAME=Lumi
AWAKE_MS=20000

# ElevenLabs cloud TTS — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

API_PORT=8787

# Phone camera frames polled by the game API.
CAMERA_LINK_URL=http://127.0.0.1:8000
SURVEY_INTERVAL_MS=60000

# ---------- Phone camera link (Python: app/, static/) ----------

HOST=0.0.0.0
PORT=8443
HTTP_PORT=8000

FRAME_MAX_SIDE=1120
FRAME_JPEG_QUALITY=85
FRAME_BUFFER_SIZE=30
SAVE_FRAMES_DIR=

SIDEQUEST_API_URL=http://127.0.0.1:8787
SIDEQUEST_SESSION=demo