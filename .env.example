# Copy to .env. One file configures both apps. Blank keys fall back to mock mode.

# ---------- Sidequest game (Node: server/, web/) ----------

# Meta Model API (Muse Spark + Muse Voice Transcribe) — https://dev.meta.ai
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=low
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Google Gemini (vision) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
# MINIMAL | LOW | MEDIUM | HIGH. Lower is faster; Argon supports LOW and up.
GEMINI_THINKING_LEVEL=LOW

# "gemini" (default) or "muse" — Muse Spark 1.3 also accepts images.
VISION_PROVIDER=gemini

API_PORT=8787

# ---------- Phone camera link (Python: app/, static/) ----------

HOST=0.0.0.0
# HTTPS port the phone opens
PORT=8443
# Plain HTTP on 127.0.0.1 for the laptop viewer
HTTP_PORT=8000

FRAME_MAX_SIDE=1120
FRAME_JPEG_QUALITY=85
FRAME_BUFFER_SIZE=30
# Set to a folder name (e.g. captures) to write every frame to disk
SAVE_FRAMES_DIR=

# Llama vision backend (OpenAI-compatible). Defaults target a local Ollama.
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_MODEL=llama3.2-vision
LLAMA_API_KEY=ollama
LLAMA_MAX_TOKENS=512
LLAMA_TIMEOUT=120
